# =============================================================================
# DADIU 2026 — Wwise Adventure Game course repository
#
# NOTE ON PATH ANCHORING
# The Unity project does NOT live at the repo root; it sits at
#   WwiseAdventureGame2025.1.3.421/WwiseAdventureGameSource/
# and the Wwise authoring project at
#   WwiseAdventureGame2025.1.3.421/Wwise Project/
# Therefore every pattern below is deliberately written WITHOUT a leading
# slash, so it matches at any depth. Do not "fix" these into /[Ll]ibrary/
# style rooted patterns — that is what let Library/ into git in the first place.
# =============================================================================


# -----------------------------------------------------------------------------
# Unity — generated / machine-local
# -----------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Aa]rtifacts/
.utmp/
*.log

# MemoryCaptures can get excessive in size and may contain sensitive data.
[Mm]emoryCaptures/

# Recordings can get excessive in size.
[Rr]ecordings/

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Asset Store tools (uncomment if you ever import them)
# [Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*


# -----------------------------------------------------------------------------
# Wwise — authoring project
#
# KEEP in git: .wproj, all *.wwu work units, and Originals/ (the source audio).
# IGNORE: caches, per-user settings, and everything SoundBank generation emits.
# -----------------------------------------------------------------------------

# Wwise SoundBank / conversion cache — large, fully regenerable
.cache/

# Per-user authoring state. These are stamped with the local Windows username
# (e.g. "Wwise Adventure Game.danne.wsettings"), so committing them guarantees
# a merge conflict for every student on the course.
*.wsettings
*.validationcache
*.wuser
*.akd
*.wlgs

# Wwise auto-backups and recovery copies
[Bb]ackup/
*.wproj.bak
*.wwu.bak

# Profiler captures and authoring logs
*.prof
*.wwiselog
WwiseAuthoringLog*

# Wwise Launcher / integration bundles downloaded next to the project
WwiseUnityIntegration_*_Src.zip
WwiseUnityIntegration_*.zip


# -----------------------------------------------------------------------------
# Wwise — generated SoundBanks (build output, never commit)
#
# Students generate these locally via Wwise > Generate SoundBanks. The output
# path is set in Assets/WwiseSettings.xml (RootOutputPath).
# -----------------------------------------------------------------------------
GeneratedSoundBanks/
[Aa]ssets/WwiseData/
[Aa]ssets/[Ss]treamingAssets/[Aa]udio/GeneratedSoundBanks/
*.bnk
*.wem
SoundbanksInfo.xml
SoundbanksInfo.json
Init.txt
*_SoundBanksInfo.xml
PluginInfo.xml
PluginInfo.json


# -----------------------------------------------------------------------------
# Generated IDE / solution files
# -----------------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp
*.opendb
*.VC.db

# Debug symbols (and their Unity meta stubs)
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Editors
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/


# -----------------------------------------------------------------------------
# Player builds & distributables
# -----------------------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# NOTE: the prebuilt reference player at
# WwiseAdventureGame2025.1.3.421/WwiseAdventureGame/ is intentionally tracked so
# students can play the finished game without building it. Do not add it here.


# -----------------------------------------------------------------------------
# OS cruft
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# Local scratch — student notes / renders kept out of the shared repo
# -----------------------------------------------------------------------------
*.local
_scratch/
_local/
